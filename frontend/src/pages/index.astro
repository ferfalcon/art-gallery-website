---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/HomeHero.astro";
import GalleryContent from "../components/GalleryContent.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Modern Art Gallery"
  description="Discover the Modern Art Gallery collection and plan a visit to 99 King Street, Newport."
>
  <main class="home-main" data-home-main>
    <HomeHero />
    <GalleryContent />
  </main>
  <div class="home-footer" data-home-footer>
    <Footer theme="dark" />
  </div>
</Layout>

<style>
  .home-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 11.25rem;
  }

  .home-footer {
    margin-block-start: 11.25rem;
  }

  @media (max-width: 67rem) {
    .home-main {
      gap: 7.5rem;
    }

    .home-footer {
      margin-block-start: 7.5rem;
    }
  }

  @media (max-width: 39.375rem) {
    .home-main {
      gap: 6.25rem;
    }

    .home-footer {
      margin-block-start: 6.25rem;
    }
  }
</style>
